# Get this from @BotFather on Telegram
BOT_TOKEN=

# The channel screenshots get posted to. Add the bot as admin of the channel,
# then set this to the channel's @username (e.g. @mychannel) or its numeric
# chat id (e.g. -1001234567890).
CHANNEL_ID=

# Public site + Convex deployment (defaults point at the live Pomodorus site).
SITE_URL=https://pomodorus.yazdan.me/
CONVEX_URL=https://tacit-clam-994.convex.cloud

# Optional: path to a Chrome/Chromium executable for screenshots. Auto-detected
# on macOS/Linux if Google Chrome or Chromium is already installed; set this
# only if auto-detection fails or you want to use a different browser.
CHROME_PATH=
